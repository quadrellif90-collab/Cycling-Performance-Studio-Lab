    <SteadyState Duration="120" Power="0.8500"/>
    <Interval Duration="90" PowerLow="0.5000" PowerHigh="0.5000"/>
    <SteadyState Duration="120" Power="0.8500"/>
    <Interval Duration="90" PowerLow="0.5000" PowerHigh="0.5000"/>
    <SteadyState Duration="120" Power="0.8500"/>
    <Interval Duration="90" PowerLow="0.5000" PowerHigh="0.5000"/>
    <SteadyState Duration="90" Power="0.8000"/>
    <Interval Duration="60" PowerLow="0.5000" PowerHigh="0.5000"/>
    <SteadyState Duration="90" Power="0.8000"/>
    <Cooldown Duration="480" PowerLow="0.5000" PowerHigh="0.6500"/>
  </workout>
</workout_file>
