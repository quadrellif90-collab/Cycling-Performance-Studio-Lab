<workout_file>
  <author>Cycling Performance Studio Lab</author>
  <name>Durability A - Negative Split 120</name>
  <description>Durability session #1 (negative split): 2h con ultimi 40 min a Z3 tempo su gambe stanche. Evidenze: Muriel 2022, Spragg 2023 — la capacità di spingere a fatica discrimina più dei numeri a fresco. docs/SCIENCE_UPDATES_2025.md §2.</description>
  <sporttype>bike</sporttype>
  <tags>durability,endurance,negative_split</tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.50" PowerHigh="0.70"/>
    <SteadyState Duration="300" Power="0.65"/>
    <SteadyState Duration="3300" Power="0.62"/>
    <SteadyState Duration="1800" Power="0.80"/>
    <SteadyState Duration="600" Power="0.85"/>
    <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.40"/>
  </workout>
</workout_file>
