    <SteadyState Duration="2400" Power="0.8200"/>
    <SteadyState Duration="750" Power="0.9000"/>
    <Cooldown Duration="480" PowerLow="0.6000" PowerHigh="0.7000"/>
  </workout>
</workout_file>
