<?xml version="1.0" ?>
<workout_file>
  <author>CPSL</author>
  <name>Duathlon Sprint - Short &amp; Sharp</name>
  <description>Sprint duathlon. Short run, fast bike, fast run finish. Total ~45min.</description>
  <category>Duathlon</category>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="300" PowerLow="0.7000" PowerHigh="0.6000"/>
    <SteadyState Duration="600" Power="0.9000"/>
    <SteadyState Duration="1200" Power="0.8800"/>
    <SteadyState Duration="600" Power="0.9200"/>
    <Cooldown Duration="300" PowerLow="0.6000" PowerHigh="0.7000"/>
  </workout>
</workout_file>
