    <SteadyState Duration="90" Power="0.5000"/>
    <SteadyState Duration="90" Power="0.5000"/>
    <SteadyState Duration="90" Power="0.5000"/>
    <SteadyState Duration="90" Power="0.5000"/>
    <SteadyState Duration="90" Power="0.5000"/>
    <Cooldown Duration="300" PowerLow="0.4000" PowerHigh="0.5000"/>
  </workout>
