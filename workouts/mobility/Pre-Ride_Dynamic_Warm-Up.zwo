  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="180" PowerLow="0.5500" PowerHigh="0.4000"/>
    <SteadyState Duration="60" Power="0.5500"/>
    <SteadyState Duration="60" Power="0.5500"/>
    <SteadyState Duration="60" Power="0.5500"/>
    <SteadyState Duration="60" Power="0.5500"/>
    <SteadyState Duration="60" Power="0.5500"/>
    <Cooldown Duration="180" PowerLow="0.4000" PowerHigh="0.5500"/>
  </workout>
</workout_file>
