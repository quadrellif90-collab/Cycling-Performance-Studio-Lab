    <SteadyState Duration="60" Power="0.7000"/>
    <Interval Duration="45" PowerLow="0.5000" PowerHigh="0.5000"/>
    <SteadyState Duration="60" Power="0.7000"/>
    <Interval Duration="45" PowerLow="0.5000" PowerHigh="0.5000"/>
    <SteadyState Duration="60" Power="0.7000"/>
    <Interval Duration="45" PowerLow="0.5000" PowerHigh="0.5000"/>
    <SteadyState Duration="60" Power="0.7000"/>
    <Interval Duration="45" PowerLow="0.5000" PowerHigh="0.5000"/>
    <SteadyState Duration="60" Power="0.7000"/>
    <Cooldown Duration="300" PowerLow="0.5000" PowerHigh="0.6500"/>
  </workout>
</workout_file>
