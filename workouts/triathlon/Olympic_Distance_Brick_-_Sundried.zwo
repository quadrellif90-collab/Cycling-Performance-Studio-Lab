  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="1800" PowerLow="0.7000" PowerHigh="0.6000"/>
    <SteadyState Duration="1200" Power="0.8000"/>
    <SteadyState Duration="600" Power="0.7000"/>
    <SteadyState Duration="300" Power="0.9000"/>
    <SteadyState Duration="1200" Power="0.8000"/>
    <Cooldown Duration="600" PowerLow="0.6000" PowerHigh="0.7000"/>
  </workout>
</workout_file>
