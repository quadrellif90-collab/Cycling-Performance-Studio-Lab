<workout_file>
  <author>Cycling Performance Studio Lab</author>
  <name>Durability D - Muscular Endurance 90</name>
  <description>Durability session #4 (muscular endurance): 3x15 min Z3 continuativo (76-90% FTP) con recupero 5 min. Costruisce resistenza al danno muscolare e tolleranza a sforzi sub-soglia prolungati. docs/SCIENCE_UPDATES_2025.md §2.</description>
  <sporttype>bike</sporttype>
  <tags>durability,muscular_endurance,tempo</tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.50" PowerHigh="0.70"/>
    <SteadyState Duration="300" Power="0.65"/>
    <IntervalsT Repeat="3" OnDuration="900" OffDuration="300" OnPower="0.85" OffPower="0.55"/>
    <SteadyState Duration="600" Power="0.55"/>
    <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.40"/>
  </workout>
</workout_file>
