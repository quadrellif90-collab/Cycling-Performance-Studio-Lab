<?xml version="1.0" ?>
<workout_file>
  <author>CPSL</author>
  <name>Active Recovery Spin</name>
  <description>Easy recovery spin. Keep HR low, legs spinning. Total ~30min.</description>
  <category>Recovery</category>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="300" PowerLow="0.5000" PowerHigh="0.4000"/>
    <SteadyState Duration="1200" Power="0.5000"/>
    <Cooldown Duration="300" PowerLow="0.4000" PowerHigh="0.5000"/>
  </workout>
</workout_file>
