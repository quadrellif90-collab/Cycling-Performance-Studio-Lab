{
  "manifest_version": 3,
  "name": "CPSL for Intervals.icu",
  "version": "0.1.0",
  "description": "Porta Cycling Performance Studio Lab dentro Intervals.icu: indicatori calcolati (forma/HRV/peso), analisi AI e bridge al tuo CPSL locale.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://intervals.icu/*"],
  "content_scripts": [
    {
      "matches": ["https://intervals.icu/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
