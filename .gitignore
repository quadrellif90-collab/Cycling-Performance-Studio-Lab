.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Build artifacts
*.exe
*.dmg
*.AppImage
*.deb
*.rpm
*.msi

# PyInstaller
*.manifest
*.spec

# Temporary files
tmp/
temp/
*.tmp